# Release build (gradlew assembleRelease / expo export) shu faylni avtomatik o'qiydi.
# Dev rejimda (expo start) esa lib/config.ts hostUri'dan LAN manzilini o'zi topadi.
EXPO_PUBLIC_API_BASE_URL=https://nuriddin-building.uz/api
