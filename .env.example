# --- Umumiy ---
TIMEZONE=Asia/Tashkent
# XAVFSIZ DEFAULT: false. DEBUG=true bo'lsa (a) /auth/dev-login ochiladi —
# bitta telegram_id raqami bilan ISTALGAN foydalanuvchi (jumladan Boshliq)
# tokeni olinadi, (b) /docs, /redoc, /openapi.json ochiq bo'ladi, (c) placeholder
# sirlar bilan ishga tushishga ruxsat beriladi. Shu shablonni nusxalab deploy
# qilinganda tizim himoyasiz qolmasligi uchun bu yerda ataylab false turibdi.
# Lokal ishlab chiqishda o'z .env faylingizda true qiling.
DEBUG=false

# --- Bot ---
BOT_TOKEN=
# Faqat cPanel (shared hosting) deploy uchun: bot alohida polling jarayoni emas,
# shu API ichida webhook orqali ishlaydi. Docker/VPS'da FALSE qoldiring (bot
# alohida polling qiladi). Batafsil: DEPLOY-CPANEL.md
BOT_WEBHOOK_ENABLED=false

# --- Ma'lumotlar bazasi ---
# SQLite — mavjud app.db faylini serverga yuklaysiz (ma'lumotlar bilan). Yo'l
# ilova ildiziga nisbatan (./app.db = ~/hodimlar-tizimi/app.db).
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Docker (VPS) uchun PostgreSQL misoli — compose POSTGRES_PASSWORD bilan o'rnatadi:
# DATABASE_URL=postgresql+asyncpg://hodimlar:PAROL@db:5432/hodimlar
# PostgreSQL paroli. BO'SH QOLDIRMANG: docker-compose'da ilgari
# `${POSTGRES_PASSWORD:-hodimlar}` zaxira qiymati bor edi, ya'ni o'zgaruvchi
# belgilanmasa baza JIMGINA "hodimlar" paroli bilan ko'tarilardi. Endi
# compose xato bilan to'xtaydi. Tasodifiy qiymat:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- API ---
# PRODUCTION: har ikkala sirni tasodifiy qiymat bilan almashtiring, masalan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-secret
# 43200 daqiqa = 30 kun. Kamaytirmang: xodim davomatni kuniga 2 marta
# ishlatadi, 1440 (24 soat) bo'lsa har kuni qaytadan login qiladi.
# Bekor qilish uchun refresh-token kerak emas — xodimni `is_active=false`
# qilish tokenni darhol kesadi (api/deps.py: get_current_user).
JWT_EXPIRE_MINUTES=43200
# Bot/scheduler -> API ichki kaliti (X-Bot-Secret). DIQQAT: bu kalit
# `/auth/bot-token` orqali to'liq DASTURCHI JWT'sini beradi — ya'ni u
# superadmin parolига teng. Kamida 32 belgi, tasodifiy:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
BOT_SHARED_SECRET=please-change-this-bot-secret
# Telegram webhook sekreti — BOT_SHARED_SECRET dan ALOHIDA qiymat qo'ying.
# Nega: webhook sekreti tashqi tomonga (Telegram) beriladi va sizib chiqish
# ehtimoli yuqoriroq; ikkalasi bir xil bo'lsa bitta sizish butun tizimni
# ochadi. Bo'sh qoldirilsa — orqaga moslik uchun BOT_SHARED_SECRET ishlatiladi.
# O'zgartirgandan keyin: python scripts/set_webhook.py
TELEGRAM_WEBHOOK_SECRET=
# Oldimizda turgan ISHONCHLI proxy soni. Rate-limit mijoz IP'sini
# `X-Forwarded-For` ro'yxatining OXIRIDAN shu songa qarab oladi: nginx
# `$proxy_add_x_forwarded_for` bilan MIJOZ yuborgan sarlavhaga qo'shadi, ya'ni
# BIRINCHI qiymat mijozning o'zi yozgani va unga ishonib bo'lmaydi (aks holda
# hujumchi har so'rovda boshqa IP yozib, cheklovni aylanib o'tadi).
# cPanel'da (nginx + LiteSpeed) 2 bo'lishi mumkin — tekshirib ko'ring.
TRUSTED_PROXY_COUNT=1
# Production'da sayt domeni (CORS uchun), masalan https://hodimlar.example.uz
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# --- Sayt (Telegram Login) ---
TELEGRAM_LOGIN_BOT_USERNAME=

# --- Guruhlar (2-bosqich) ---
# Asosiy guruh — mobilograf videolari va issiq lid xabarlari shu yerga tushadi.
# Chat ID odatda manfiy son (masalan -1001234567890). Bilish uchun botni guruhga
# qo'shing va @userinfobot yoki botning update logidan foydalaning.
TELEGRAM_GROUP_CHAT_ID=
# Qo'shimcha statistika guruh(lar)i (ixtiyoriy). Kunlik/haftalik digest DOIM asosiy
# guruhga chiqadi; bu yerga yozilgan guruh(lar)ga ham HAM yuboriladi (nusxa). Bir
# nechta guruh bo'lsa vergul bilan ajrating: -100111,-100222. Bo'sh — faqat asosiy guruh.
TELEGRAM_STATS_GROUP_CHAT_ID=

# --- CRM (3-bosqich) ---
# none | amocrm | onec | uysot — "none" bo'lsa CRM sinxronizatsiyasi o'tkazib yuboriladi,
# kunlik natijalar faqat qo'lda (sayt orqali) kiritiladi.
CRM_TYPE=none
# amoCRM uchun: uzoq muddatli (long-lived) kirish tokeni.
# Uysot uchun: Open API tokeni (X-Open-Api-Token) — "Call History: Read" va "Lead: Read" ruxsatlari bilan.
CRM_API_KEY=
# amoCRM subdomeni, masalan "mycompany" (https://mycompany.amocrm.ru). Uysot uchun kerak emas.
CRM_AMOCRM_SUBDOMAIN=
# CRM webhook endpointlarini himoya qilish uchun maxfiy kalit (uzun tasodifiy
# qiymat: python -c "import secrets;print(secrets.token_urlsafe(32))").
# Uysot webhook (2026-08-01 da ochildi, hozircha faqat lid eventlari): Uysot
# kabinetiga shu URL yoziladi (sekret URL'ning o'zida — qaysi header bilan
# yuborilishi hujjatlashtirilmaguncha eng ishonchli kanal):
#   https://<domen>/api/crm-webhook/uysot?secret=<shu qiymat>
# Bo'sh qolsa webhook endpointi yopiq (403) turadi.
CRM_WEBHOOK_SECRET=
# Lid POLLING skanlari (diff-tick/reconcile, issiq-lid detect, LeadStageDaily lid
# skani). 2026-08-01 dan default O'CHIQ (false) — lid voqealari webhook'dan keladi,
# CRM'ga behuda skan so'rovlari ketmaydi. true — eski polling rejimi (favqulodda
# zaxira). MUHOFAZA: CRM_WEBHOOK_SECRET bo'sh bo'lsa polling avtomatik davom
# etadi — lid oqimi hech qachon butunlay o'chib qolmaydi.
# Qo'ng'iroq tarixi (call-history) skanlariga bu bayroq TA'SIR QILMAYDI —
# webhook qo'ng'iroq ma'lumotini bermaydi.
CRM_LEAD_POLLING_ENABLED=false
# Uysot uchun: "tashrif" deb hisoblanadigan pipeline bosqichining ID'si.
# GET /v1/open-api/pipe/all (X-Open-Api-Token bilan) chaqirib, kerakli bosqichning
# "id" qiymatini shu yerga qo'ying (masalan "Tashrif" nomli bosqich).
CRM_UYSOT_VISIT_PIPE_STATUS_ID=
# Operator AI sabab tekshiruvi: "hali ishlanmagan (ochiq/yangi)" deb hisoblanadigan
# bosqich ID'lari, vergul bilan (masalan "101,102" — "Yangi lid", "Aloqa kutilmoqda").
# Operator "lid/baza tugadi" desa, shu bosqichlarda unga biriktirilgan lidlar CRM'dan
# sanaladi: 0 ta bo'lsa sabab tasdiqlanadi, bor bo'lsa rahbarga ogohlantirish ketadi.
# Bo'sh qoldirilsa bu tekshiruv o'chiq (sabab baribir yoziladi, hukmsiz).
CRM_UYSOT_OPEN_LEAD_PIPE_STATUS_IDS=
# Uysot'ga daqiqasiga jami nechta so'rov yuborishga ruxsat (barcha joblar uchun
# UMUMIY markaziy byudjet, crm/uysot.py). Uysot limiti 60/daqiqa — default 50
# ataylab pastroq (qo'lda so'rov/boshqa integratsiya uchun zaxira). Uysot
# limitni o'zgartirsa shu qiymatni moslang.
CRM_UYSOT_MAX_REQUESTS_PER_MINUTE=50
# Soatlik reja AVTOMATIK eslatmasi (bot har soatda xodimlarga xabar yuboradi).
# Default o'chiq — haqiqiy xodimlarga xabar ketgani sabab. Ishga tushirishga
# tayyor bo'lganda true qo'ying. Botdagi "📋 Bugungi rejam" tugmasi bundan
# qat'i nazar ishlayveradi (xodimning o'zi ochadi).
HOURLY_PLAN_ENABLED=false

# --- Operator AI (avto-reja + AI murabbiy) ---
# Default o'chiq: o'chiq bo'lsa avto-reja endpointlari no-op, AI matnlari
# deterministik shablon bilan yoziladi (tashqi API chaqirilmaydi).
AI_ENABLED=false
# Matn yozadigan provayder: anthropic (Claude, tavsiya) | gemini (bepul tier).
# Hisob-qarorlar har doim kodda — provayder faqat matn sifatiga ta'sir qiladi.
# OPERATOR_ prefiksi ataylab: umumiy AI_PROVIDER/GEMINI_API_KEY nomlarini boshqa
# vositalar (ollama va h.k.) global env'da band qilgan bo'lishi mumkin.
OPERATOR_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
OPERATOR_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Nudge PUSH (soatlik kuzatuvda orqada qolgan operatorlarga Telegram xabar).
# AI_ENABLED'dan alohida opt-in — haqiqiy xodimlarga xabar ketadi. Sinov uchun
# POST /ai-watch/tick?dry_run=true (yubormasdan matnlarni qaytaradi).
AI_NUDGE_ENABLED=false

# ── Push bildirishnomalar (Firebase Cloud Messaging) ──
# Ikkalasi ham bo'sh bo'lsa push JIM o'chiq turadi — Telegram xabarlari
# avvalgidek ishlayveradi, hech narsa buzilmaydi.
#
# FCM_PROJECT_ID — Firebase konsolidagi loyiha ID (masalan "nb-hodimlar").
# FCM_SERVICE_ACCOUNT_FILE — service-account JSON kalitiga TO'LIQ yo'l.
#   Firebase konsoli > Project settings > Service accounts >
#   "Generate new private key". Bu fayl REPODAN TASHQARIDA saqlanadi
#   (masalan ~/secrets/fcm.json) va git'ga TUSHMASLIGI shart.
#
# Ilova tomonida esa android/app/google-services.json kerak (boshqa fayl!) —
# u .gitignore'da, bo'lmasa APK push'siz quriladi (build yiqilmaydi).
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
